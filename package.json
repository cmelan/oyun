{
  "name": "oyun-game",
  "version": "2.0.0",
  "description": "A kind, non-violent puzzle-platformer for young children",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit",
    "fetch-photos": "node scripts/fetch-photos.mjs",
    "native:sync:ios": "npm run build && cap sync ios",
    "native:build:ios": "npm run native:sync:ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Release -destination 'generic/platform=iOS' CODE_SIGNING_ALLOWED=NO build",
    "qa:devices": "node scripts/device-shots.mjs",
    "submission:media": "node scripts/submission-media.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@revenuecat/purchases-capacitor": "^13.2.4",
    "@revenuecat/purchases-capacitor-ui": "^13.2.4"
  }
}
