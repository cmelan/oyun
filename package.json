{
  "name": "oyun-game",
  "version": "2.0.0",
  "description": "A kind, non-violent puzzle-platformer for young children",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit",
    "fetch-photos": "node scripts/fetch-photos.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
